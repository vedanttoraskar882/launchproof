# LaunchProof Environment Variables
# Configure these in your hosting environment (e.g. Vercel Project Settings > Environment Variables)

# 1. Recipient Business Email (Owner's verified email address to receive registrations & enquiries)
BUSINESS_EMAIL=your-business-email@example.co.uk

# 2. Transactional Email Provider (Choose one: Resend is recommended for Vercel)
# Resend API Key (get from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: Verified sender email address (Defaults to notifications@launchproof.co.uk or your verified domain in Resend)
EMAIL_FROM="LaunchProof <notifications@launchproof.co.uk>"

# Optional alternative providers:
# SENDGRID_API_KEY=SG.your_sendgrid_key
# POSTMARK_SERVER_TOKEN=your_postmark_token
